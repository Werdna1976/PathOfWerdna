[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/systems/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://scenes/player/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://scripts/components/follow_camera.gd" id="3_camera"]
[ext_resource type="Script" path="res://scripts/systems/hud.gd" id="4_hud"]
[ext_resource type="Script" path="res://scripts/ui/ground_labels.gd" id="5_labels"]

[node name="Main" type="Node3D"]
script = ExtResource("1_game")

[node name="Player" parent="." instance=ExtResource("2_player")]

[node name="Camera" type="Camera3D" parent="." node_paths=PackedStringArray("target")]
fov = 35.0
far = 200.0
current = true
script = ExtResource("3_camera")
target = NodePath("../Player")

[node name="Hud" type="CanvasLayer" parent="."]
script = ExtResource("4_hud")

[node name="GroundLabels" type="CanvasLayer" parent="."]
script = ExtResource("5_labels")
